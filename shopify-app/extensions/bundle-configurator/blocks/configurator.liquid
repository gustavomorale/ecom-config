{% comment %}
  CraftFrame Bundle Quiz app block.
  The config JSON lives in an app-owned metafield (namespace: bundle_configurator,
  key: config). Nothing in this block is brand-specific; the merchant's choices arrive
  through the metafield and the theme's computed styles via theme-inherit.js.
  With no config yet (fresh install), the block shows a setup note inside the theme
  editor only and renders nothing on the live storefront.
{% endcomment %}
{% assign bcfg_config = shop.metafields.bundle_configurator.config.value %}

{% if bcfg_config == blank %}
  {% if request.design_mode %}
    <div class="bcfg-unconfigured" style="padding:24px;border:1px dashed #999;border-radius:12px;text-align:center;font:14px/1.5 system-ui,sans-serif;color:#555">
      <strong style="display:block;color:#222;margin-bottom:4px">CraftFrame Bundle Quiz</strong>
      Finish the five-step setup in the CraftFrame Bundle Quiz app and this block will show your questionnaire here.
    </div>
  {% endif %}
{% else %}
  {{ 'configurator.css' | asset_url | stylesheet_tag }}
  {% if block.settings.preset == 'glass' %}{{ 'glass.css' | asset_url | stylesheet_tag }}{% endif %}

  {%- liquid
    assign bcfg_max = 'none'
    if block.settings.width == 'page'
      assign bcfg_max = '1200px'
    elsif block.settings.width == 'narrow'
      assign bcfg_max = '960px'
    endif
  -%}
  <style>
    .shopify-app-block:has(> #bcfg-{{ block.id }}) { width: 100%; max-width: 100%; flex: 1 1 100%; align-self: stretch; }
    #bcfg-{{ block.id }} { width: 100%; max-width: {{ bcfg_max }}; margin-inline: auto; box-sizing: border-box; }
  </style>
  <div id="bcfg-{{ block.id }}" class="bcfg-mount" data-preset="{{ block.settings.preset }}" data-performance="{{ block.settings.performance }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}"></div>

  <script src="{{ 'configurator.js' | asset_url }}" defer></script>
  <script src="{{ 'scenes.js' | asset_url }}" defer></script>
  <script src="{{ 'theme-inherit.js' | asset_url }}" defer></script>
  <script type="application/json" id="bcfg-config-{{ block.id }}">{{ bcfg_config | json }}</script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('bcfg-{{ block.id }}');
      var raw = document.getElementById('bcfg-config-{{ block.id }}').textContent;
      var cfg = null;
      try { cfg = JSON.parse(raw); } catch (e) { }
      if (!cfg || !cfg.steps || !window.BundleConfigurator) return;
      cfg.brand = cfg.brand || {};
      cfg.brand.preset = el.dataset.preset || cfg.brand.preset || 'glass';
      if (el.dataset.performance) cfg.brand.performance = el.dataset.performance;
      // Prices are the store's, so show them in the store's currency and the page's locale.
      if (el.dataset.currency) {
        cfg.cart = cfg.cart || {};
        cfg.cart.currency = el.dataset.currency;
        cfg.cart.useIntl = true;
        if (el.dataset.locale) cfg.cart.locale = el.dataset.locale;
      }
      // Theme sync: inherit the storefront look. When the sniffer reports a weak
      // match (neutral buttons, no accent found) keep only type and corners and let
      // the widget use its own colours. brand.inheritTheme: false | 'always' overrides.
      if (cfg.brand.inheritTheme !== false && window.BundleConfigurator.sniffHost) {
        var p = window.BundleConfigurator.sniffHost(document);
        var t = window.BundleConfigurator.tokensFrom(p);
        if (p.confidence && p.confidence.level === 'low' && cfg.brand.inheritTheme !== 'always') {
          t = { font: t.font, radius: t.radius, 'radius-sm': t['radius-sm'], 'radius-pill': t['radius-pill'] };
        }
        cfg.brand.inherited = t;
        cfg.brand.inheritConfidence = p.confidence;
      }
      window.BundleConfigurator.mount(el, cfg);
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "CraftFrame Bundle Quiz",
  "target": "section",
  "settings": [
    { "type": "select", "id": "preset", "label": "Look", "default": "glass",
      "info": "Glass adds translucency and depth. Base is flat.",
      "options": [ { "value": "glass", "label": "Glass" }, { "value": "base", "label": "Base" } ] },
    { "type": "select", "id": "width", "label": "Width", "default": "full",
      "info": "How much of the section the questionnaire fills on desktop.",
      "options": [ { "value": "full", "label": "Fill the section" }, { "value": "page", "label": "Page width" }, { "value": "narrow", "label": "Narrow" } ] },
    { "type": "select", "id": "performance", "label": "Performance", "default": "auto",
      "info": "Auto steps Glass down to flat surfaces on slow devices.",
      "options": [ { "value": "auto", "label": "Auto" }, { "value": "full", "label": "Always full" }, { "value": "lite", "label": "Always lite" } ] }
  ]
}
{% endschema %}
