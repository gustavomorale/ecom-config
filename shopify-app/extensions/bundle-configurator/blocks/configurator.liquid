{% comment %}
  CraftFrame Bundle Quiz app block.
  Each quiz's config JSON lives in an app-owned metafield (namespace:
  bundle_configurator): Quiz 1 in key "config", quizzes 2 to 25 in "quiz_2" ...
  "quiz_25". The block's Quiz setting picks the number. The "status" metafield
  holds what every quiz shares: the plan's attribution line, how many quizzes the
  plan includes (a higher number is paused) and stopMonth (a Free store at its
  limit stops sending completions until the 1st).
  Nothing in this block is brand-specific. With no config, or a paused quiz, the
  block shows a note inside the theme editor only and renders nothing on the
  live storefront.
{% endcomment %}
{%- liquid
  assign bcfg_quiz = block.settings.quiz | default: '1'
  if bcfg_quiz == '1'
    assign bcfg_key = 'config'
  else
    assign bcfg_key = 'quiz_' | append: bcfg_quiz
  endif
  assign bcfg_config = shop.metafields.bundle_configurator[bcfg_key].value
  assign bcfg_status = shop.metafields.bundle_configurator.status.value
  assign bcfg_paused = false
  if bcfg_status.quizzes
    assign bcfg_qn = bcfg_quiz | plus: 0
    if bcfg_qn > bcfg_status.quizzes
      assign bcfg_paused = true
    endif
  endif
-%}

{% if bcfg_config == blank or bcfg_paused %}
  {% if request.design_mode %}
    <div class="bcfg-unconfigured" style="padding:24px;border:1px dashed #999;border-radius:12px;text-align:center;font:14px/1.5 system-ui,sans-serif;color:#555">
      <strong style="display:block;color:#222;margin-bottom:4px">CraftFrame Bundle Quiz: Quiz {{ bcfg_quiz }}</strong>
      {%- if bcfg_paused -%}
        Quiz {{ bcfg_quiz }} is paused: your plan includes {{ bcfg_status.quizzes }} quiz{% if bcfg_status.quizzes != 1 %}zes{% endif %}. Choose a bigger plan in the app, or pick another quiz in this block's settings.
      {%- else -%}
        Quiz {{ bcfg_quiz }} is not set up yet. Set it up in the CraftFrame Bundle Quiz app (Quizzes), or pick another quiz in this block's settings.
      {%- endif -%}
    </div>
  {% endif %}
{% else %}
  {{ 'configurator.css' | asset_url | stylesheet_tag }}
  {% if block.settings.preset == 'glass' %}{{ 'glass.css' | asset_url | stylesheet_tag }}{% endif %}

  {%- liquid
    assign bcfg_max = 'none'
    if block.settings.width == 'page'
      assign bcfg_max = '1200px'
    elsif block.settings.width == 'narrow'
      assign bcfg_max = '960px'
    endif
  -%}
  <style>
    .shopify-app-block:has(> #bcfg-{{ block.id }}) { width: 100%; max-width: 100%; flex: 1 1 100%; align-self: stretch; }
    #bcfg-{{ block.id }} { width: 100%; max-width: {{ bcfg_max }}; margin-inline: auto; box-sizing: border-box; }
    {%- if block.settings.width == 'full' %}
    /* Edge to edge on any theme: themes wrap app blocks in a page-width container
       (Dawn) or a centred flex row (Horizon), so step out of it. --bcfg-vw is the
       viewport without the scrollbar, set by the script below; 100vw alone would
       add a horizontal scrollbar on Windows. */
    #bcfg-{{ block.id }} { width: var(--bcfg-vw, 100vw); max-width: none; margin-left: calc(50% - var(--bcfg-vw, 100vw) / 2); margin-right: 0; }
    {%- endif %}
  </style>
  <div id="bcfg-{{ block.id }}" class="bcfg-mount" data-preset="{{ block.settings.preset }}" data-performance="{{ block.settings.performance }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}"></div>

  <script src="{{ 'configurator.js' | asset_url }}" defer></script>
  <script src="{{ 'scenes.js' | asset_url }}" defer></script>
  <script src="{{ 'theme-inherit.js' | asset_url }}" defer></script>
  <script type="application/json" id="bcfg-config-{{ block.id }}">{{ bcfg_config | json }}</script>
  <script type="application/json" id="bcfg-status-{{ block.id }}">{{ bcfg_status | json }}</script>
  <script>
    (function () {
      var setVw = function () { document.documentElement.style.setProperty('--bcfg-vw', document.documentElement.clientWidth + 'px'); };
      setVw(); window.addEventListener('resize', setVw);
    })();
    document.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('bcfg-{{ block.id }}');
      var raw = document.getElementById('bcfg-config-{{ block.id }}').textContent;
      var cfg = null;
      try { cfg = JSON.parse(raw); } catch (e) { }
      if (!cfg || !cfg.steps || !window.BundleConfigurator) return;
      var status = null;
      try { status = JSON.parse(document.getElementById('bcfg-status-{{ block.id }}').textContent); } catch (e) { }
      // The plan is shared by every quiz and kept on the status metafield; older
      // configs carry their own copy (config.plan), used when status is missing.
      if (status && status.plan) cfg.plan = { key: status.plan, attribution: !!status.attribution };
      cfg.brand = cfg.brand || {};
      cfg.brand.preset = el.dataset.preset || cfg.brand.preset || 'glass';
      if (el.dataset.performance) cfg.brand.performance = el.dataset.performance;
      // Prices are the store's, so show them in the store's currency and the page's locale.
      if (el.dataset.currency) {
        cfg.cart = cfg.cart || {};
        cfg.cart.currency = el.dataset.currency;
        cfg.cart.useIntl = true;
        if (el.dataset.locale) cfg.cart.locale = el.dataset.locale;
      }
      // Theme sync: inherit the storefront look. When the sniffer reports a weak
      // match (neutral buttons, no accent found) keep only type and corners and let
      // the widget use its own colours. brand.inheritTheme: false | 'always' overrides.
      if (cfg.brand.inheritTheme !== false && window.BundleConfigurator.sniffHost) {
        var p = window.BundleConfigurator.sniffHost(document);
        var t = window.BundleConfigurator.tokensFrom(p);
        if (p.confidence && p.confidence.level === 'low' && cfg.brand.inheritTheme !== 'always') {
          t = { font: t.font, radius: t.radius, 'radius-sm': t['radius-sm'], 'radius-pill': t['radius-pill'] };
        }
        cfg.brand.inherited = t;
        cfg.brand.inheritConfidence = p.confidence;
      }
      var inst = window.BundleConfigurator.mount(el, cfg);
      // Count a finished quiz for the store's plan: a number and the quiz number
      // only, sent to the app through the store's own domain. Never the answers.
      // Not once a Free store has reached its limit this month (status.stopMonth).
      {%- unless request.design_mode %}
      var month = new Date().toISOString().slice(0, 7);
      if (!(status && status.stopMonth === month)) {
        inst.on('complete', function () {
          try {
            fetch('/apps/bundle-quiz/event', { method: 'POST', keepalive: true, credentials: 'omit',
              headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: 'complete', quiz: '{{ bcfg_quiz }}' }) }).catch(function () {});
          } catch (e) {}
        });
      }
      {%- endunless %}
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "CraftFrame Bundle Quiz",
  "target": "section",
  "settings": [
    { "type": "select", "id": "quiz", "label": "Quiz", "default": "1",
      "info": "Which of your quizzes this block shows. The numbers are on the Quizzes page in the app.",
      "options": [ { "value": "1", "label": "Quiz 1 (main)" }, { "value": "2", "label": "Quiz 2" }, { "value": "3", "label": "Quiz 3" }, { "value": "4", "label": "Quiz 4" }, { "value": "5", "label": "Quiz 5" }, { "value": "6", "label": "Quiz 6" }, { "value": "7", "label": "Quiz 7" }, { "value": "8", "label": "Quiz 8" }, { "value": "9", "label": "Quiz 9" }, { "value": "10", "label": "Quiz 10" }, { "value": "11", "label": "Quiz 11" }, { "value": "12", "label": "Quiz 12" }, { "value": "13", "label": "Quiz 13" }, { "value": "14", "label": "Quiz 14" }, { "value": "15", "label": "Quiz 15" }, { "value": "16", "label": "Quiz 16" }, { "value": "17", "label": "Quiz 17" }, { "value": "18", "label": "Quiz 18" }, { "value": "19", "label": "Quiz 19" }, { "value": "20", "label": "Quiz 20" }, { "value": "21", "label": "Quiz 21" }, { "value": "22", "label": "Quiz 22" }, { "value": "23", "label": "Quiz 23" }, { "value": "24", "label": "Quiz 24" }, { "value": "25", "label": "Quiz 25" } ] },
    { "type": "select", "id": "preset", "label": "Look", "default": "glass",
      "info": "Glass adds translucency and depth. Base is flat.",
      "options": [ { "value": "glass", "label": "Glass" }, { "value": "base", "label": "Base" } ] },
    { "type": "select", "id": "width", "label": "Width", "default": "full",
      "info": "Full width ignores the theme's page margins. The questions stay centred.",
      "options": [ { "value": "full", "label": "Full width, edge to edge" }, { "value": "section", "label": "Fill the section" }, { "value": "page", "label": "Page width" }, { "value": "narrow", "label": "Narrow" } ] },
    { "type": "select", "id": "performance", "label": "Performance", "default": "auto",
      "info": "Auto steps Glass down to flat surfaces on slow devices.",
      "options": [ { "value": "auto", "label": "Auto" }, { "value": "full", "label": "Always full" }, { "value": "lite", "label": "Always lite" } ] }
  ]
}
{% endschema %}
