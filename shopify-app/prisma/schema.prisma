// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native for local dev, rhel for Netlify Functions (AWS Lambda)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Postgres on Neon, for production (Netlify) and for local dev alike, so there
// is one provider and one migration history. DATABASE_URL comes from .env
// locally and from Netlify's environment in production.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Quiz completions per shop per calendar month (UTC), counted when a shopper
// reaches a result. A number only: no answers, no shopper data. Plan limits
// read it. month is "YYYY-MM".
model Usage {
  shop        String
  month       String
  completions Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([shop, month])
}

// Completions per quiz (1.0, multiple quizzes). Usage keeps the store's total,
// which is what plan limits read; this is only for the Quizzes page. quiz is
// the quiz number as a string ("1" to "25").
model QuizUsage {
  shop        String
  month       String
  quiz        String
  completions Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([shop, month, quiz])
}
